{
  "dependencies": [
    "miniz",
    {
      "name": "libarchive",
      "default-features": false,
      "features": [
        "bzip2",
        "crypto",
        "lz4",
        "lzma",
        "zstd"
      ]
    },
    {
      "name": "libarchive",
      "features": [
        "xar"
      ],
      "platform": "!windows"
    }
  ],
  "vcpkg-configuration": {
    "overlay-ports": [
      "./extension-ci-tools/vcpkg_ports"
    ],
    "overlay-triplets": [
      "./extension-ci-tools/toolchains"
    ]
  }
}
