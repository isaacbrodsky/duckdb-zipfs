# name: test/sql/streaming_large_entries.test
# description: exercise the streaming read paths added when compressed entries
# group: [sql]

#              stopped being buffered fully into memory. DEFLATE (zip) and all
#              archive:// / compressed:// entries are streamed forward-only
#              (CanSeek() == false), so sequential readers (read_csv,
#              read_json) succeed with bounded memory. Random-access formats
#              (parquet, whose footer is at the end of the file) are buffered
#              in memory as before, so they keep working.

require zipfs

require parquet

require json

require notwindows

# ------------------------------------------------------------------------------
# Parquet inside a zip. numbers.parquet is DEFLATE-compressed. Parquet reads the
# footer at the END of the file and then seeks around, which a forward-only
# stream cannot serve, so random-access formats keep the buffered path.
# ------------------------------------------------------------------------------

query II
SELECT count(*), sum(id) FROM 'zip://examples/data.zip/numbers.parquet';
----
10000	49995000

# ------------------------------------------------------------------------------
# NDJSON inside a zip (50k rows, ~2.4 MB uncompressed). The JSON reader goes back
# to the start of the file after sniffing it; a streamed member restarts
# inflation on a backward read instead of failing.
# ------------------------------------------------------------------------------

query II
SELECT count(*), sum(dbl)
FROM read_json('zip://examples/streaming/jsonl_large.zip/numbers.jsonl', format = 'newline_delimited');
----
50000	2499950000

query I
SELECT name
FROM read_json('zip://examples/streaming/jsonl_large.zip/numbers.jsonl', format = 'newline_delimited')
WHERE id = 49999;
----
row_49999

# ------------------------------------------------------------------------------
# Large CSV inside a zip (uncompressed ~190 KB, far larger than ZIP_BLOCK_SIZE),
# so the streaming read loop spans many blocks. read_csv is a forward sequential
# reader: O(n) time, bounded memory. This is the case the streaming design
# targets.
# ------------------------------------------------------------------------------

query II
SELECT count(*), sum(dbl) FROM 'zip://examples/data.zip/numbers.csv';
----
10000	99990000

query I
SELECT name FROM 'zip://examples/data.zip/numbers.csv' WHERE id = 5000;
----
row_5000

# Re-open the same entry twice in one query (self join) to confirm a fresh
# stream is started each time rather than reusing exhausted state.
query I
SELECT count(*)
FROM 'zip://examples/data.zip/numbers.csv' a
JOIN 'zip://examples/data.zip/numbers.csv' b USING (id)
WHERE a.id < 100;
----
100

# ------------------------------------------------------------------------------
# Same entries inside a tar.gz, read through archive:// (libarchive). archive://
# streams CSV forward and buffers parquet, just like DEFLATE in a zip.
# ------------------------------------------------------------------------------

statement ok
SET zipfs_split = "!!";

query II
SELECT count(*), sum(id) FROM 'archive://examples/data.tar.gz!!numbers.parquet';
----
10000	49995000

query I
SELECT name FROM 'archive://examples/data.tar.gz!!numbers.csv' WHERE id = 9999;
----
row_9999

# ------------------------------------------------------------------------------
# Raw gzip (compressed://) does NOT record the uncompressed size, so GetFileSize
# triggers a one-time streaming discard pass. Reading it then re-opens the
# stream. Both must agree and stay bounded in memory. Forward reads only.
# ------------------------------------------------------------------------------

query II
SELECT count(*), sum(dbl)
FROM read_csv('compressed://examples/numbers.csv.gz', compression = 'uncompressed');
----
10000	99990000

query I
SELECT name
FROM read_csv('compressed://examples/numbers.csv.gz', compression = 'uncompressed')
WHERE id = 1234;
----
row_1234
