# name: test/sql/archivefs_write.test
# description: test zipfs extension, writing
# group: [sql]

require zipfs

# Ideally the error would be clearer, likeL
# IO Error: Archive file system can only open for reading

statement error
COPY
    (FROM generate_series(100_000))
    TO 'archive://examples/output.zip/test.csv'
    (FORMAT 'csv');
----
Not implemented Error: ArchiveFileSystem: DirectoryExists is not implemented!

statement error
COPY
    (FROM generate_series(100_000))
    TO 'compressed://examples/output.csv'
    (FORMAT 'csv');
----
Not implemented Error: RawArchiveFileSystem: DirectoryExists is not implemented!
