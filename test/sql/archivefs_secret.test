# name: test/sql/archivefs_secret.test
# description: test zipfs extension, passphrase
# group: [sql]

statement error
create secret zip_pass (
    type zip,
    password 'password',
    scope 'archive://examples/passworded.zip'
);
----
Invalid Input Error: Secret type 'zip' not found

require zipfs

statement error
select * from 'archive://examples/passworded.zip/secret_file.csv';
----
IO Error: Failed to read: Passphrase required for this entry

statement ok
create secret zip_wrong_pass (
    type zip,
    password 'pass____',
    scope 'archive://examples/passworded.zip'
);

statement error
select * from 'archive://examples/passworded.zip/secret_file.csv';
----
IO Error: Failed to read: Incorrect passphrase

statement ok
drop secret zip_wrong_pass;

statement ok
create secret zip_wrong_pass (
    type zip,
    password '',
    scope 'archive://examples/passworded.zip'
);

statement error
select * from 'archive://examples/passworded.zip/secret_file.csv';
----
IO Error: Failed to register archive passphrase: Empty passphrase is unacceptable

statement ok
drop secret zip_wrong_pass;

statement ok
create secret zip_pass (
    type zip,
    password 'password',
    scope 'archive://examples/passworded.zip'
);

query I
select * from 'archive://examples/passworded.zip/secret_file.csv';
----
secret3

statement error
select * from 'zip://examples/passworded.zip/secret_file.csv';
----
IO Error: Encrypted file
