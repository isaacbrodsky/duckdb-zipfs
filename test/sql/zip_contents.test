nested_dir/	0	true	false
nested_dir/some_file.jsonl	26	false	false
nested_dir/some_file.csv	12	false	false
a.csv	24	false	false
a.jsonl	26	false	false
b.csv	11	false	false
b.jsonl	26	false	false

